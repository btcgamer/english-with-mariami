{
  "name": "english-with-mariami",
  "version": "1.0.0",
  "private": true,
  "description": "English with Mariami \u2014 Holographic English Academy",
  "scripts": {
    "web:prepare": "node scripts/prepare-web.mjs",
    "android:add": "npm run web:prepare && npx cap add android",
    "android:sync": "npm run web:prepare && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "android:apk": "node scripts/build-android-debug.mjs",
    "android:release": "node scripts/build-android-release.mjs",
    "test:billing": "node --test qa/play-verification.test.mjs",
    "test:web-billing": "node --test qa/web-billing.test.mjs",
    "android:upload-internal": "node scripts/upload-play-internal.mjs",
    "content:export": "node scripts/export-private-content.mjs",
    "test:content": "node --test qa/paid-course.test.mjs",
    "content:import": "node scripts/import-private-content.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/assets": "3.0.5",
    "typescript": "5.9.2"
  }
}
